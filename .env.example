APP_NAME=AI Metrics Backend
APP_ENV=development
APP_VERSION=1.0.0

DATABASE_URL=sqlite:///./ai_metrics.db
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
LOG_LEVEL=INFO
ADMIN_EMAIL=ericsonjosedossantos@tieri659.onmicrosoft.com

ENABLE_OPENAPI=true
ENABLE_REQUEST_LOGGING=true
REQUIRE_HTTPS=false

# Produção: exemplo seguro
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://ai_metrics:${POSTGRES_PASSWORD}@postgres:5432/ai_metrics
# CORS_ORIGINS=https://app.suaempresa.com.br
# ENABLE_OPENAPI=false
# REQUIRE_HTTPS=true
# LOG_LEVEL=INFO
